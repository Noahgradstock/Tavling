# Copy to .env.local. Generate real values with: node scripts/create-users.mjs sofie anna tom

# Signs session cookies. At least 32 random characters.
SESSION_SECRET=

# Login accounts as userId:salt:scryptHash, comma separated. Never put plain passwords here.
AUTH_USERS=

# Optional: Gemini routes free-text questions to a topic. Without it, keyword matching is used.
GEMINI_API_KEY=
